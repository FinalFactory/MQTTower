FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY MQTTower.sln ./
COPY src ./src
RUN dotnet publish src/MQTTower.Agent/MQTTower.Agent.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 5080 5100
ENTRYPOINT ["dotnet", "MQTTower.Agent.dll"]

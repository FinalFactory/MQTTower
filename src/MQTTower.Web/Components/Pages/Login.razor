@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer
@using Microsoft.JSInterop
@inject NavigationManager Nav
@inject IJSRuntime Js

<PageTitle>Login</PageTitle>

<MudPaper Class="pa-8 ma-auto" Style="max-width:420px;margin-top:10vh" Elevation="8">
    <div class="mqtt-login-logo mb-4">
        <img src="/mqttower-icon.png" alt="MQTTower" />
    </div>
    <form @onsubmit="LoginAsync" @onsubmit:preventDefault>
        <MudTextField @bind-Value="_user" Label="User" Variant="Variant.Outlined" Class="mb-2" />
        <MudTextField @bind-Value="_pass" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Class="mb-4" />
        <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary" Variant="Variant.Filled" FullWidth="true" Disabled="_busy">Sign in</MudButton>
    </form>
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    }
</MudPaper>

@code {
    private string _user = "admin";
    private string _pass = string.Empty;
    private string? _error;
    private bool _busy;

    private async Task LoginAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var url = Nav.ToAbsoluteUri("/api/auth/login").ToString();
            var ok = await Js.InvokeAsync<bool>("mqttowerAuth.login", url, _user, _pass).ConfigureAwait(false);
            if (!ok)
            {
                _error = "Invalid credentials.";
                return;
            }

            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (JSException)
        {
            _error = "Invalid credentials.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}

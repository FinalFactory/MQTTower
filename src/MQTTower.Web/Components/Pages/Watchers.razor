@page "/watchers"
@rendermode InteractiveServer
@implements IDisposable
@inject BrokerContext BrokerCtx
@inject IWatcherService WatcherService
@inject IBrokerRegistry BrokerRegistry
@inject IDialogService DialogService

<PageTitle>Watchers</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Topic watchers</MudText>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync" Disabled="@(BrokerCtx.Selected is null)">Add watcher</MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>

<MudTable Items="@_items" Hover="true" Dense="true" Loading="_loading">
    <HeaderContent>
        @if (BrokerCtx.Selected is null)
        {
            <MudTh>Broker</MudTh>
        }
        <MudTh>Name</MudTh>
        <MudTh>Topic</MudTh>
        <MudTh>Condition</MudTh>
        <MudTh>Enabled</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="row">
        @if (BrokerCtx.Selected is null)
        {
            <MudTd>@BrokerLabel(row.BrokerId)</MudTd>
        }
        <MudTd>@row.Name</MudTd>
        <MudTd Style="word-break:break-all">@row.TopicPattern</MudTd>
        <MudTd>@row.Condition</MudTd>
        <MudTd>@(row.Enabled ? "yes" : "no")</MudTd>
        <MudTd Style="text-align:right">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditAsync(row))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="@(() => DeleteAsync(row.Id))" />
                </Authorized>
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<TopicWatcher> _items = new();
    private bool _loading;
    private Dictionary<Guid, string> _brokerNames = new();

    protected override async Task OnInitializedAsync()
    {
        BrokerCtx.Changed += OnBrokerChanged;
        await LoadAsync().ConfigureAwait(false);
    }

    public void Dispose() => BrokerCtx.Changed -= OnBrokerChanged;

    private void OnBrokerChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await LoadAsync().ConfigureAwait(false);
            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (BrokerCtx.Selected is null)
            {
                var brokers = await BrokerRegistry.ListAsync().ConfigureAwait(false);
                _brokerNames = brokers.ToDictionary(b => b.Id, b => b.Name);
            }

            _items = (await WatcherService.ListAsync(BrokerCtx.Selected?.Id).ConfigureAwait(false)).ToList();
        }
        finally
        {
            _loading = false;
        }
    }

    private string BrokerLabel(Guid? brokerId) =>
        brokerId is null ? "—" : (_brokerNames.TryGetValue(brokerId.Value, out var n) ? n : brokerId.Value.ToString());

    private async Task OpenCreateAsync()
    {
        var w = new TopicWatcher { BrokerId = BrokerCtx.Selected?.Id, Name = "New watcher", TopicPattern = "mqttower/#", Condition = string.Empty };
        await ShowAsync("New watcher", w);
    }

    private async Task EditAsync(TopicWatcher w) => await ShowAsync("Edit watcher", w);

    private async Task ShowAsync(string title, TopicWatcher w)
    {
        var p = new DialogParameters { [nameof(WatcherEditDialog.Initial)] = w };
        var d = (await DialogService.ShowAsync<WatcherEditDialog>(title, p))!;
        var r = (await d.Result!)!;
        if (!r.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        var p = new DialogParameters { [nameof(ConfirmDialog.Message)] = "Delete this watcher?" };
        var d = (await DialogService.ShowAsync<ConfirmDialog>("Delete", p))!;
        var r = (await d.Result!)!;
        if (r.Canceled || r.Data is not true)
        {
            return;
        }

        await WatcherService.DeleteAsync(id).ConfigureAwait(false);
        await LoadAsync();
    }
}

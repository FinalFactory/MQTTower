@page "/broker-logs"
@rendermode InteractiveServer
@implements IDisposable
@using MQTTower.Infrastructure.Agents
@inject IBrokerGatewayFactory GatewayFactory
@inject BrokerContext BrokerCtx
@inject IJSRuntime JS
@inject ISnackbar Snackbar

<PageTitle>Broker Logs</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4" Wrap="Wrap.Wrap">
    <MudText Typo="Typo.h4">Broker logs</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
        @if (BrokerCtx.Selected is not null && !_loading)
        {
            @if (_liveMode == "sse")
            {
                <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.Circle">Live</MudChip>
            }
            else if (_liveMode == "poll")
            {
                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Sync">Polling</MudChip>
            }
        }
        <MudTooltip Text="Copy all lines">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Color="Color.Default" Disabled="@(BrokerCtx.Selected is null || _lines.Count == 0)" OnClick="CopyAllAsync" aria-label="Copy logs to clipboard" />
        </MudTooltip>
        <MudTooltip Text="Download as .txt">
            <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Default" Disabled="@(BrokerCtx.Selected is null || _lines.Count == 0)" OnClick="DownloadAsync" aria-label="Download logs as text file" />
        </MudTooltip>
    </MudStack>
</MudStack>

@if (BrokerCtx.Selected is null)
{
    <MudAlert Severity="Severity.Info">Select a broker in the header.</MudAlert>
}
else
{
    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-2" />
    }
    <MudPaper Class="pa-2 mqtt-chart-card" Elevation="2">
        <div @ref="_logPaper" class="broker-log-scroll" style="max-height:70vh;overflow:auto;font-family:ui-monospace,monospace;font-size:0.85rem;">
            @foreach (var line in _lines)
            {
                <div>@line</div>
            }
        </div>
    </MudPaper>
}

@code {
    private IReadOnlyList<string> _lines = Array.Empty<string>();
    private CancellationTokenSource? _liveCts;
    private bool _loading;
    private string _liveMode = "idle";
    private bool _shouldScroll;
    private ElementReference _logPaper;

    protected override async Task OnInitializedAsync()
    {
        BrokerCtx.Changed += OnBrokerChanged;
        if (BrokerCtx.Selected is not null)
        {
            _loading = true;
        }

        await LoadAsync().ConfigureAwait(false);
        StartLiveUpdates();
    }

    private void OnBrokerChanged()
    {
        _ = InvokeAsync(async () =>
        {
            StopLiveUpdates();
            _liveMode = "idle";
            if (BrokerCtx.Selected is not null)
            {
                _loading = true;
            }

            await LoadAsync().ConfigureAwait(false);
            StartLiveUpdates();
            StateHasChanged();
        });
    }

    private void StopLiveUpdates()
    {
        try
        {
            _liveCts?.Cancel();
        }
        catch
        {
            /* ignore */
        }

        _liveCts?.Dispose();
        _liveCts = null;
    }

    private void StartLiveUpdates()
    {
        if (BrokerCtx.Selected is null || string.IsNullOrWhiteSpace(BrokerCtx.Selected.AgentUrl))
        {
            return;
        }

        var broker = BrokerCtx.Selected;
        _liveCts = new CancellationTokenSource();
        var token = _liveCts.Token;
        _liveMode = "sse";
        _ = Task.Run(async () =>
        {
            try
            {
                var gw = GatewayFactory.Create(broker);
                try
                {
                    if (gw is AgentHttpClient http)
                    {
                        await http.RunLogsStreamLoopAsync(
                            async lines =>
                            {
                                await InvokeAsync(() =>
                                {
                                    _lines = lines;
                                    _liveMode = "sse";
                                    _shouldScroll = true;
                                    StateHasChanged();
                                    return Task.CompletedTask;
                                }).ConfigureAwait(false);
                            },
                            token).ConfigureAwait(false);
                    }
                }
                finally
                {
                    (gw as IDisposable)?.Dispose();
                }
            }
            catch
            {
                /* fall back to polling */
            }

            if (token.IsCancellationRequested)
            {
                return;
            }

            await InvokeAsync(() =>
            {
                _liveMode = "poll";
                StateHasChanged();
                return Task.CompletedTask;
            }).ConfigureAwait(false);

            using var poll = new PeriodicTimer(TimeSpan.FromSeconds(2));
            try
            {
                while (!token.IsCancellationRequested && await poll.WaitForNextTickAsync(token).ConfigureAwait(false))
                {
                    if (BrokerCtx.Selected?.Id != broker.Id)
                    {
                        break;
                    }

                    await InvokeAsync(async () =>
                    {
                        try
                        {
                            _lines = await BrokerGatewayHelper.WithGatewayAsync(
                                GatewayFactory,
                                BrokerCtx.Selected,
                                gw => gw.GetRecentLogsAsync(500),
                                Array.Empty<string>()).ConfigureAwait(false);
                            _liveMode = "poll";
                            _shouldScroll = true;
                        }
                        catch
                        {
                            _lines = Array.Empty<string>();
                        }

                        StateHasChanged();
                    }).ConfigureAwait(false);
                }
            }
            catch (OperationCanceledException)
            {
                /* normal */
            }
        }, token);
    }

    private async Task LoadAsync()
    {
        if (BrokerCtx.Selected is null)
        {
            _lines = Array.Empty<string>();
            _loading = false;
            return;
        }

        _loading = true;
        try
        {
            await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            _lines = await BrokerGatewayHelper.WithGatewayAsync(
                GatewayFactory,
                BrokerCtx.Selected,
                gw => gw.GetRecentLogsAsync(500),
                Array.Empty<string>()).ConfigureAwait(false);
            _shouldScroll = true;
        }
        catch (Exception ex)
        {
            _lines = Array.Empty<string>();
            Snackbar.Add($"Could not reach agent for logs: {ex.Message}", Severity.Warning);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CopyAllAsync()
    {
        if (_lines.Count == 0)
        {
            return;
        }

        try
        {
            var text = string.Join(Environment.NewLine, _lines);
            await JS.InvokeVoidAsync("mqttowerBrokerLogs.copyToClipboard", text).ConfigureAwait(false);
            Snackbar.Add("Copied to clipboard", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Copy failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DownloadAsync()
    {
        if (BrokerCtx.Selected is null || _lines.Count == 0)
        {
            return;
        }

        var rawName = string.IsNullOrWhiteSpace(BrokerCtx.Selected.Name) ? "broker" : BrokerCtx.Selected.Name;
        var safeName = string.Join("_", rawName.Split(Path.GetInvalidFileNameChars()));
        var file = $"broker-logs-{safeName}-{DateTime.Now:yyyyMMdd-HHmmss}.txt";
        var text = string.Join(Environment.NewLine, _lines);
        try
        {
            await JS.InvokeVoidAsync("mqttowerBrokerLogs.downloadText", file, text).ConfigureAwait(false);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScroll && !_loading)
        {
            _shouldScroll = false;
            try
            {
                await JS.InvokeVoidAsync("mqttowerBrokerLogs.scrollToBottom", _logPaper).ConfigureAwait(false);
            }
            catch
            {
                /* ignore */
            }
        }
    }

    public void Dispose()
    {
        BrokerCtx.Changed -= OnBrokerChanged;
        StopLiveUpdates();
    }
}

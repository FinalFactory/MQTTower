@page "/"
@rendermode InteractiveServer
@using MQTTower.Core.Models
@inject IBrokerStatsProvider Stats
@inject IMetricStore Metrics
@inject IAuditLog Audit
@inject IDynSecService DynSec

<PageTitle>Overview</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Overview</MudText>
    <MudStack Row="true" Spacing="1">
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">#0FF197</MudChip>
        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">#00D4FF</MudChip>
    </MudStack>
</MudStack>

<MudGrid Spacing="3">
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="mqtt-stat-card mqtt-stat-green pa-4" Elevation="6">
            <MudText Typo="Typo.subtitle2" Class="mqtt-muted">Connected Clients</MudText>
            <MudText Typo="Typo.h3" Class="mqtt-stat-value">@_stats.ConnectedClients</MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-2">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.caption" Class="mqtt-muted">+@_stats.ConnectedClientsDeltaThisHour this hour</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="mqtt-stat-card mqtt-stat-green pa-4" Elevation="6">
            <MudText Typo="Typo.subtitle2" Class="mqtt-muted">Messages/sec</MudText>
            <MudText Typo="Typo.h3" Class="mqtt-stat-value">@_stats.MessagesPerSecond.ToString("0")</MudText>
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Class="mt-2">
                <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Color="Color.Primary" Size="Size.Small" />
                <MudText Typo="Typo.caption" Class="mqtt-muted">+@_stats.MessagesPerSecondDeltaPercent.ToString("0")%</MudText>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="mqtt-stat-card mqtt-stat-cyan pa-4" Elevation="6">
            <MudText Typo="Typo.subtitle2" Class="mqtt-muted">Active Topics</MudText>
            <MudText Typo="Typo.h3" Class="mqtt-stat-value">@_stats.ActiveTopics</MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="mqtt-stat-card mqtt-stat-cyan pa-4" Elevation="6">
            <MudText Typo="Typo.subtitle2" Class="mqtt-muted">Data Rate</MudText>
            <MudText Typo="Typo.h3" Class="mqtt-stat-value">@FormatDataRate(_stats.DataRateBytesPerSecond)</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="8">
        <MudPaper Class="pa-4 mqtt-chart-card" Elevation="4">
            <MudText Typo="Typo.h6" Class="mb-2">Broker Activity — Last 24 Hours</MudText>
            <MudChart T="double" ChartType="ChartType.Line" ChartSeries="@_lineSeries" xAxisLabels="@_lineLabels" Width="100%" Height="300px" ChartOptions="@_lineOptions" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-4 mqtt-chart-card" Elevation="4">
            <MudText Typo="Typo.h6" Class="mb-2">Client Distribution</MudText>
            <MudChart T="double" ChartType="ChartType.Donut" inputData="@_donutData" inputLabels="@_donutLabels" Width="100%" Height="280px" ChartOptions="@_donutOptions" />
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mqtt-chart-card" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle1">Connected clients</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
            </MudStack>
            <MudList T="string" Dense="true" Class="mt-2">
                @foreach (var c in _clients)
                {
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">@c.Username @(c.Enabled ? "" : "(disabled)")</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="pa-4 mqtt-chart-card" Elevation="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.subtitle1">Recent Activity</MudText>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" />
            </MudStack>
            <MudList T="string" Dense="true">
                @foreach (var a in _recent)
                {
                    <MudListItem T="string">
                        <MudText Typo="Typo.body2">@a.Timestamp.LocalDateTime: @a.Action — @a.EntityName</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private BrokerStats _stats = new();
    private List<MqttClientInfo> _clients = new();
    private List<ChartSeries<double>> _lineSeries = new();
    private string[] _lineLabels = Array.Empty<string>();
    private ChartOptions _lineOptions = new();
    private double[] _donutData = Array.Empty<double>();
    private string[] _donutLabels = Array.Empty<string>();
    private ChartOptions _donutOptions = new();
    private List<AuditEntry> _recent = new();

    protected override async Task OnInitializedAsync()
    {
        _stats = Stats.GetCurrent();
        try
        {
            _clients = (await DynSec.ListClientsAsync().ConfigureAwait(false)).Take(12).ToList();
        }
        catch
        {
            _clients = new List<MqttClientInfo>();
        }

        var to = DateTimeOffset.UtcNow;
        var from = to.AddHours(-24);
        var m = await Metrics.QueryAsync("messagesPerSecond", from, to);
        _lineLabels = m.Select(x => x.CapturedAt.LocalDateTime.ToString("HH:mm")).ToArray();
        _lineSeries = new List<ChartSeries<double>>
        {
            new ChartSeries<double> { Name = "msgs/s", Data = m.Select(x => x.Value).ToArray() },
        };
        _lineOptions = new ChartOptions();

        _donutLabels = new[] { "Tasmota", "ESP Devices", "Home Assistant", "Other" };
        _donutData = new[] { 42d, 31d, 18d, 9d };
        _donutOptions = new ChartOptions { ChartPalette = new[] { "#00D4FF", "#0FF197", "#FFD54F", "#FF5252" } };

        _recent = (await Audit.QueryAsync(from, to, null, 0, 8)).ToList();
    }

    private static string FormatDataRate(double bps)
    {
        if (bps > 1024 * 1024)
        {
            return $"{bps / 1024 / 1024:0.0} MB/s";
        }

        if (bps > 1024)
        {
            return $"{bps / 1024:0.0} KB/s";
        }

        return $"{bps:0} B/s";
    }
}

@page "/clients"
@rendermode InteractiveServer
@inject IDynSecService DynSec
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Clients</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4">Clients</MudText>
    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAsync">
                Add client
            </MudButton>
        </Authorized>
    </AuthorizeView>
</MudStack>

<MudTable Items="@FilteredItems" Hover="true" Dense="true" Loading="_loading">
    <ToolBarContent>
        <MudTextField @bind-Value="_search" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>Username</MudTh>
        <MudTh>Enabled</MudTh>
        <MudTh Style="text-align:right">Actions</MudTh>
    </HeaderContent>
    <RowTemplate Context="row">
        <MudTd DataLabel="Username">@row.Username</MudTd>
        <MudTd DataLabel="Enabled">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudSwitch T="bool" Color="Color.Primary" Value="@row.Enabled" ValueChanged="@(async v => await SetEnabledAsync(row.Username, v))" />
                </Authorized>
                <NotAuthorized>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">@(row.Enabled ? "on" : "off")</MudChip>
                </NotAuthorized>
            </AuthorizeView>
        </MudTd>
        <MudTd DataLabel="Actions" Style="text-align:right">
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" aria-label="delete" OnClick="@(() => DeleteAsync(row.Username))" />
                </Authorized>
            </AuthorizeView>
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    private List<MqttClientInfo> _items = new();
    private bool _loading;
    private string _search = string.Empty;

    private IEnumerable<MqttClientInfo> FilteredItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(x => x.Username.Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _items = (await DynSec.ListClientsAsync().ConfigureAwait(false)).ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreateAsync()
    {
        var d = await DialogService.ShowAsync<ClientEditDialog>("New client");
        var r = await d.Result;
        if (!r.Canceled)
        {
            await LoadAsync();
        }
    }

    private async Task SetEnabledAsync(string username, bool enabled)
    {
        try
        {
            await DynSec.SetClientEnabledAsync(username, enabled).ConfigureAwait(false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteAsync(string username)
    {
        var p = new DialogParameters { [nameof(ConfirmDialog.Message)] = $"Delete client {username}?" };
        var d = await DialogService.ShowAsync<ConfirmDialog>("Delete client", p);
        var r = await d.Result;
        if (r.Canceled || r.Data is not true)
        {
            return;
        }

        try
        {
            await DynSec.DeleteClientAsync(username).ConfigureAwait(false);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}

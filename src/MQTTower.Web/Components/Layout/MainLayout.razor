@inherits LayoutComponentBase
@using MQTTower.Web.Theme

<MudThemeProvider Theme="MQTTowerTheme.Instance" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Color="Color.Default" Class="mqtt-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Class="ml-1" OnClick="@ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2 mqtt-wordmark">MQTTower</MudText>
        <MudSpacer />
        <MudTextField @bind-Value="_search"
                      Placeholder="Search clients, topics, devices..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mqtt-search flex-grow-1 mx-4"
                      Margin="Margin.Dense" />
        <MudBadge Content="1" Color="Color.Error" Overlap="true" Bordered="true">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Primary" />
        </MudBadge>
        <MudButton Variant="Variant.Text" Href="/logout" Class="ml-2">Sign out</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="0" Class="mqtt-drawer">
        <MudDrawerHeader Class="mqtt-drawer-header">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIcon Icon="@Icons.Material.Filled.Hub" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h6">MQTTower</MudText>
            </MudStack>
        </MudDrawerHeader>
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="mqtt-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _dark = true;
    private string _search = string.Empty;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}

@inherits LayoutComponentBase
@using MQTTower.Web.Theme

<MudThemeProvider Theme="MQTTowerTheme.Instance" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Color="Color.Default" Class="mqtt-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Primary" Class="ml-1" OnClick="@ToggleDrawer" />
        <img src="/mqttower-icon-no-text.png" alt="" class="mqtt-appbar-icon" />
        <MudText Typo="Typo.h6" Class="ml-2 mqtt-wordmark">MQTTower</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Href="/logout" Class="ml-2">Sign out</MudButton>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Breakpoint="Breakpoint.Md" ClipMode="DrawerClipMode.Always" Elevation="0" Class="mqtt-drawer">
        <div class="mqtt-broker-shell">
            <BrokerSelector />
        </div>
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="mqtt-main">
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _dark = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;
}

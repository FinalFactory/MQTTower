@using MQTTower.Core.Interfaces
@inject IBrokerGatewayFactory GatewayFactory
@inject BrokerContext BrokerCtx
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-2" />
        }
        <MudTextField @bind-Value="_name" Label="Role name" Variant="Variant.Outlined" Class="mb-2" Required="true" Disabled="@IsEdit" />
        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Class="mb-2" Disabled="@IsEdit" HelperText="@(IsEdit ? "Description changes require Mosquitto modifyRole (not wired)." : null)" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">ACL entries</MudText>
        @for (var i = 0; i < _acls.Count; i++)
        {
            var idx = i;
            <MudPaper Class="pa-2 mb-2" Outlined="true">
                <MudTextField @bind-Value="_acls[idx].TopicPattern" Label="Topic pattern" Variant="Variant.Outlined" Class="mb-2" />
                <MudSelect T="AclType" @bind-Value="_acls[idx].AclType" Label="Type" Variant="Variant.Outlined" Class="mb-2">
                    @foreach (var t in Enum.GetValues<AclType>())
                    {
                        <MudSelectItem Value="@t">@t</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="_acls[idx].Priority" Label="Priority" Variant="Variant.Outlined" Class="mb-2" />
                <MudSwitch @bind-Value="_acls[idx].Allow" Color="Color.Primary" Label="Allow" Class="mb-2" />
                <MudButton Size="Size.Small" OnClick="@(() => RemoveAcl(idx))">Remove</MudButton>
            </MudPaper>
        }
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAcl">Add ACL</MudButton>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@_saving">@(IsEdit ? "Save" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? EditRoleName { get; set; }

    private bool IsEdit => !string.IsNullOrEmpty(EditRoleName);

    private string _name = string.Empty;
    private string _description = string.Empty;
    private List<AclEntry> _acls = new() { new() { TopicPattern = "#", AclType = AclType.PublishSubscribe, Allow = true } };
    private List<AclEntry> _originalExpanded = new();
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        if (IsEdit)
        {
            try
            {
                var role = await BrokerGatewayHelper.WithGatewayAsync(
                    GatewayFactory,
                    BrokerCtx.Selected,
                    gw => gw.GetRoleAsync(EditRoleName!),
                    new MqttRole { Name = EditRoleName! });
                _name = role.Name;
                _description = role.Description ?? string.Empty;
                _acls = role.Acls.Count > 0
                    ? role.Acls.Select(CloneAcl).ToList()
                    : new List<AclEntry>();
                _originalExpanded = ExpandAclFlat(_acls).Select(CloneAcl).ToList();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }

        _loading = false;
    }

    private static AclEntry CloneAcl(AclEntry a) =>
        new()
        {
            TopicPattern = a.TopicPattern,
            AclType = a.AclType,
            Allow = a.Allow,
            Priority = a.Priority,
        };

    private void AddAcl() => _acls.Add(new AclEntry { TopicPattern = "#", AclType = AclType.Publish, Allow = true });

    private void RemoveAcl(int index)
    {
        if (index >= 0 && index < _acls.Count)
        {
            _acls.RemoveAt(index);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (IsEdit)
            {
                var newExpanded = ExpandAclFlat(_acls);
                var oldKeys = _originalExpanded.Select(AclSignature).ToHashSet(StringComparer.Ordinal);
                var newKeys = newExpanded.Select(AclSignature).ToHashSet(StringComparer.Ordinal);

                await BrokerGatewayHelper.WithGatewayAsync(GatewayFactory, BrokerCtx.Selected, async gw =>
                {
                    foreach (var a in _originalExpanded)
                    {
                        if (!newKeys.Contains(AclSignature(a)))
                        {
                            await gw.RemoveRoleAclAsync(_name, a);
                        }
                    }

                    foreach (var a in newExpanded)
                    {
                        if (!oldKeys.Contains(AclSignature(a)))
                        {
                            await gw.AddRoleAclAsync(_name, a);
                        }
                    }
                });
            }
            else
            {
                await BrokerGatewayHelper.WithGatewayAsync(GatewayFactory, BrokerCtx.Selected, async gw =>
                    await gw.CreateRoleAsync(_name, _description, _acls));
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string AclSignature(AclEntry a) =>
        $"{a.AclType}:{a.TopicPattern}:{a.Priority}:{a.Allow}";

    private static IEnumerable<AclEntry> ExpandAclFlat(IReadOnlyList<AclEntry> acls)
    {
        foreach (var a in acls)
        {
            if (a.AclType == AclType.PublishSubscribe)
            {
                yield return new AclEntry { TopicPattern = a.TopicPattern, AclType = AclType.Publish, Allow = a.Allow, Priority = a.Priority };
                yield return new AclEntry { TopicPattern = a.TopicPattern, AclType = AclType.Subscribe, Allow = a.Allow, Priority = a.Priority };
            }
            else
            {
                yield return CloneAcl(a);
            }
        }
    }
}

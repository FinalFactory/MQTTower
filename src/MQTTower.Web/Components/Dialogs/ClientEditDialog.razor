@using MQTTower.Core.Interfaces
@inject IBrokerGatewayFactory GatewayFactory
@inject BrokerContext BrokerCtx
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Class="mb-2" Required="true" />
        <MudTextField @bind-Value="_password" Label="Password" Variant="Variant.Outlined" InputType="InputType.Password" Required="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private string _username = string.Empty;
    private string _password = string.Empty;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        try
        {
            await BrokerGatewayHelper.WithGatewayAsync(GatewayFactory, BrokerCtx.Selected, async gw =>
                await gw.CreateClientAsync(_username, _password, null, null).ConfigureAwait(false)).ConfigureAwait(false);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not create client: {ex.Message}", Severity.Error);
        }
    }
}

@using MQTTower.Core.Interfaces
@inject IBrokerGatewayFactory GatewayFactory
@inject BrokerContext BrokerCtx
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Class="mb-2" />
        }
        <MudTextField @bind-Value="_name" Label="Group name" Variant="Variant.Outlined" Class="mb-2" Required="true" Disabled="@IsEdit" />
        <MudTextField @bind-Value="_description" Label="Description" Variant="Variant.Outlined" Class="mb-2" Disabled="@IsEdit" HelperText="@(IsEdit ? "Description changes require Mosquitto modifyGroup (not wired)." : null)" />
        <MudText Typo="Typo.subtitle2" Class="mb-1">Roles</MudText>
        <MudStack Class="mb-3" Spacing="0">
            @foreach (var r in _allRoleNames)
            {
                <MudCheckBox T="bool" Value="@_selectedRoles.Contains(r)" ValueChanged="@(v => OnRoleToggled(r, v))" Label="@r" Dense="true" Color="Color.Primary" />
            }
        </MudStack>
        <MudText Typo="Typo.subtitle2" Class="mb-1">Clients</MudText>
        <MudStack Spacing="0">
            @foreach (var c in _allClientNames)
            {
                <MudCheckBox T="bool" Value="@_selectedClients.Contains(c)" ValueChanged="@(v => OnClientToggled(c, v))" Label="@c" Dense="true" Color="Color.Primary" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@_saving">@(IsEdit ? "Save" : "Create")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string? EditGroupName { get; set; }

    private bool IsEdit => !string.IsNullOrEmpty(EditGroupName);

    private string _name = string.Empty;
    private string _description = string.Empty;
    private List<string> _allRoleNames = new();
    private List<string> _allClientNames = new();
    private readonly HashSet<string> _selectedRoles = new(StringComparer.Ordinal);
    private readonly HashSet<string> _selectedClients = new(StringComparer.Ordinal);
    private readonly HashSet<string> _originalRoles = new(StringComparer.Ordinal);
    private readonly HashSet<string> _originalClients = new(StringComparer.Ordinal);
    private bool _loading = true;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var roles = await BrokerGatewayHelper.WithGatewayAsync(GatewayFactory, BrokerCtx.Selected, gw => gw.ListRolesAsync(), Array.Empty<MqttRole>());
            _allRoleNames = roles.Select(r => r.Name).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
            var clients = await BrokerGatewayHelper.WithGatewayAsync(GatewayFactory, BrokerCtx.Selected, gw => gw.ListClientsAsync(), Array.Empty<MqttClientInfo>());
            _allClientNames = clients.Select(c => c.Username).OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();

            if (IsEdit)
            {
                var g = await BrokerGatewayHelper.WithGatewayAsync(
                    GatewayFactory,
                    BrokerCtx.Selected,
                    gw => gw.GetGroupAsync(EditGroupName!),
                    new MqttGroup { Name = EditGroupName! });
                _name = g.Name;
                _description = g.Description ?? string.Empty;
                _selectedRoles.Clear();
                foreach (var r in g.RoleNames)
                {
                    _selectedRoles.Add(r);
                }

                _selectedClients.Clear();
                foreach (var c in g.ClientUsernames)
                {
                    _selectedClients.Add(c);
                }

                _originalRoles.Clear();
                foreach (var r in g.RoleNames)
                {
                    _originalRoles.Add(r);
                }

                _originalClients.Clear();
                foreach (var c in g.ClientUsernames)
                {
                    _originalClients.Add(c);
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnRoleToggled(string role, bool on)
    {
        if (on)
        {
            _selectedRoles.Add(role);
        }
        else
        {
            _selectedRoles.Remove(role);
        }
    }

    private void OnClientToggled(string client, bool on)
    {
        if (on)
        {
            _selectedClients.Add(client);
        }
        else
        {
            _selectedClients.Remove(client);
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            if (IsEdit)
            {
                await BrokerGatewayHelper.WithGatewayAsync(GatewayFactory, BrokerCtx.Selected, async gw =>
                {
                    foreach (var r in _selectedRoles.Where(x => !_originalRoles.Contains(x)))
                    {
                        await gw.AddGroupRoleAsync(_name, r);
                    }

                    foreach (var r in _originalRoles.Where(x => !_selectedRoles.Contains(x)))
                    {
                        await gw.RemoveGroupRoleAsync(_name, r);
                    }

                    foreach (var c in _selectedClients.Where(x => !_originalClients.Contains(x)))
                    {
                        await gw.AddGroupClientAsync(_name, c);
                    }

                    foreach (var c in _originalClients.Where(x => !_selectedClients.Contains(x)))
                    {
                        await gw.RemoveGroupClientAsync(_name, c);
                    }
                });
            }
            else
            {
                var roles = _selectedRoles.ToList();
                var clients = _selectedClients.ToList();
                await BrokerGatewayHelper.WithGatewayAsync(GatewayFactory, BrokerCtx.Selected, async gw =>
                    await gw.CreateGroupAsync(_name, _description, roles, clients));
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
